# ============================================================
# AI GATEWAY API — Environment variables (Node.js flow)
# Copy this file to .env for `npm run dev:node` / `npm start`.
# For Cloudflare local dev, copy .dev.vars.example to .dev.vars.
# In production (Cloudflare Pages), set these in:
#   Dashboard > your Pages project > Settings > Environment variables
# ============================================================

# --- Routing -------------------------------------------------
# Default provider used when a request does not specify "provider".
# One of: openrouter | groq | gemini | custom
DEFAULT_PROVIDER=openrouter

# --- OpenRouter ----------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-real-key
# Optional model override (legacy MODEL_NAME also supported)
OPENROUTER_MODEL=z-ai/glm-5.2:free

# --- Groq (optional) ------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Google Gemini (optional) ---------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Custom OpenAI-compatible provider (optional) --------------
# Works with: OpenAI, DeepSeek, Together, vLLM, Ollama (OpenAI mode),
# LM Studio, OpenRouter itself, or ANY OpenAI-compatible base URL.
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# --- Secure YOUR OWN API (recommended in production) -----------
# If set, clients must send header:  X-API-Key: <this value>
# Leave empty to keep the API open.
API_SECRET_KEY=

# --- CORS ------------------------------------------------------
# Comma-separated origins, or * for all (default *).
# Example: ALLOWED_ORIGINS=https://yoursite.com,https://app.yoursite.com
ALLOWED_ORIGINS=*

# --- Rate limiting (per instance; see README for Cloudflare note)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=15

# --- Validation & upstream behavior ----------------------------
MAX_MESSAGE_LENGTH=8000
MAX_MESSAGES=50
MAX_TOKENS_LIMIT=8192
PROVIDER_TIMEOUT_MS=60000

# --- Misc ------------------------------------------------------
APP_URL=http://localhost:5000
NODE_ENV=development
PORT=5000
